# Dirección TCP en la que este microservicio escucha (el api-gateway le
# habla por acá). Por defecto corre en el mismo servidor que el resto.
# Usar 127.0.0.1 (IPv4), no 'localhost': en Windows 'localhost' se resuelve
# a IPv6 (::1) y el gateway no lograba conectarse (login en "Pending").
# Igual el código traduce 'localhost' a 127.0.0.1.
SERVICE_HOST=127.0.0.1
SERVICE_PORT=3001

# Conexión a la base de datos MySQL (core_db).
DB_HOST=127.0.0.1
DB_PORT=3010
DB_USERNAME=root
DB_PASSWORD=password_core_db
DB_DATABASE=core_db

# Usados por otras partes del servicio (JWT, etc. si aplica).
JWT_SECRET=your-secret-key
