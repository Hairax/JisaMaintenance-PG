# Puerto donde escucha el api-gateway.
PORT=3000

# Orígenes permitidos por CORS, separados por coma. Acá va la dirección
# fija del servidor donde corre el frontend — la misma sirve para acceso
# por LAN o por VPN, ya que ambas llegan al mismo servidor interno.
# Incluir TODOS los orígenes desde donde se abre el frontend (protocolo +
# host + puerto exactos). Puertos del frontend: 3333 = Vite en desarrollo
# (web-app/vite.config.ts), 8095 = build publicado en IIS.
# Para el servidor de la empresa (IP fija 192.168.5.5):
# CORS_ORIGINS=http://localhost:3333,http://192.168.5.5:3333,http://localhost:8095,http://192.168.5.5:8095
# Sin esta variable solo se acepta localhost/127.0.0.1 en 3333 y 8095.
CORS_ORIGINS=http://localhost:3333,http://127.0.0.1:3333,http://localhost:8095,http://127.0.0.1:8095

# Tiempo máximo (ms) que el gateway espera a un microservicio antes de
# responder 504, en vez de dejar la petición del navegador colgada.
MICROSERVICE_TIMEOUT_MS=15000

# Direcciones de los microservicios internos. Por defecto todos corren en
# el mismo servidor (127.0.0.1, IPv4 — no usar 'localhost', ver
# auth-service/.env.example) — solo hace falta tocar esto si algún día se
# separan en máquinas distintas.
AUTH_SERVICE_HOST=127.0.0.1
AUTH_SERVICE_PORT=3001
USER_SERVICE_HOST=127.0.0.1
USER_SERVICE_PORT=3002
INVENTORY_SERVICE_HOST=127.0.0.1
INVENTORY_SERVICE_PORT=3003
OT_SERVICE_HOST=127.0.0.1
OT_SERVICE_PORT=3004
