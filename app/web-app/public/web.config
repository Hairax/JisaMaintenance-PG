<?xml version="1.0" encoding="utf-8"?>
<!--
  Configuración para publicar el build (dist) en IIS. Vite copia este archivo
  a dist/ en cada `npm run build`.
  Las rutas del frontend (/login, /home, /ot...) no existen como archivos: se
  reescriben a index.html para que React Router las resuelva. Los archivos y
  carpetas reales (assets/, index.html...) se sirven tal cual.
  Requiere el módulo URL Rewrite de IIS.
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="SPA - rutas del frontend" stopProcessing="true">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
            <add input="{REQUEST_FILENAME}" matchType="IsDirectory" negate="true" />
          </conditions>
          <action type="Rewrite" url="/index.html" />
        </rule>
      </rules>
    </rewrite>
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
  </system.webServer>
</configuration>
